# Copiar a .env.local para `vercel dev`, o setear en el dashboard de Vercel.

# Turso — creá una DB en https://turso.tech y sacá URL + token.
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Secreto HMAC para firmar los JWT. Generá uno con: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please

# Usuario admin sembrado en el primer arranque de la DB (si no existe).
ADMIN_USER=admin
ADMIN_PASS=cambiame
