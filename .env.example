# Copy to .env and edit. `docker compose` lo lee automáticamente.
# .env está en .gitignore — no lo commitees con valores reales.

# Usuario admin sembrado en el primer arranque de la DB.
ADMIN_USER=admin
ADMIN_PASS=cambiame

# Secreto HMAC para firmar los JWT. Mínimo 32 chars aleatorios.
# Generá uno con: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please
